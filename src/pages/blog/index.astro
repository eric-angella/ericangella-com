---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing — Eric Angella" description="All posts by Eric Angella">
  <p class="section-label" style="padding-top: 60px;">All Writing</p>
  <PostList posts={posts} />
</BaseLayout>