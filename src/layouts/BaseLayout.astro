---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Eric Angella',
  description = 'Notes on building things, without the bloat.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="Eric Angella" href="/rss.xml" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a href="/" class="brand">EA</a>
        <nav>
          <a href="/">Writing</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <div class="wrap">
      <slot />

      <hr class="rule" />

      <footer>
        <div class="links">
          <a href="/rss.xml">RSS</a>
          <a href="mailto:eric@ericangella.com">Email</a>
          <a href="https://github.com/eric-angella">GitHub</a>
        </div>
        <div class="copyright">© {new Date().getFullYear()} Eric Angella</div>
      </footer>
    </div>

    <style>
      header.nav {
        padding: 28px 0 0;
      }
      .nav-inner {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
      }
      .nav-inner a {
        text-decoration: none;
      }
      .nav-inner nav a {
        margin-left: 20px;
      }
      .brand {
        color: var(--text);
        letter-spacing: 0.08em;
      }
      footer {
        padding: 32px 0 70px;
      }
      footer .links {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-faint);
        display: flex;
        gap: 22px;
      }
      footer a {
        text-decoration: none;
        color: var(--text-faint);
      }
      footer a:hover {
        color: var(--text);
      }
      footer .copyright {
        margin-top: 18px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-faint);
        letter-spacing: 0.04em;
      }
    </style>
  </body>
</html>
